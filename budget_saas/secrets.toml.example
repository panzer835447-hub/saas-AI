# 複製成 budget_saas/secrets.toml 並填入金鑰（不要上傳到 GitHub）。
# 部署到雲端時改用平台的環境變數設定，名稱相同。
# 若這個檔案不存在，會改讀舊版的 .streamlit/secrets.toml。

# 優先使用的服務：gemini / groq / openrouter / rules；失敗時自動改用其他已填金鑰的服務，全部失敗才用內建規則
AI_PROVIDER = "gemini"

GEMINI_API_KEY = ""
# GEMINI_MODEL = "gemini-flash-lite-latest"

GROQ_API_KEY = ""
# GROQ_MODEL = "llama-3.3-70b-versatile"

OPENROUTER_API_KEY = ""
# OPENROUTER_MODEL = "meta-llama/llama-3.3-70b-instruct:free"
